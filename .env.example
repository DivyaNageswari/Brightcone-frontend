# Copy to .env.development (git-ignored). Read in ONE place: src/config/env.ts, which validates these at start-up.
# Never put secrets in VITE_ variables: every one is public in the browser bundle.

# Where the dev server forwards /api calls (the Loco backend)
VITE_PROXY_TARGET=http://localhost:5150
# Base path (or full URL) the browser calls. Keep /api so dev and production behave the same.
VITE_API_URL=/api
# Product name shown on the sign-in page and in the sidebar
VITE_APP_NAME=Brightcone People Plus
# Show the internal UI-kit page (/ui-kit). Always on in development; off by default in production.
VITE_ENABLE_UI_KIT=false
